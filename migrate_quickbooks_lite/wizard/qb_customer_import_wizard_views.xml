<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_qb_customer_import_wizard_form" model="ir.ui.view">
        <field name="name">qb.customer.import.wizard.form</field>
        <field name="model">qb.customer.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import QuickBooks Customers">
                <field name="state" invisible="1"/>

                <group invisible="state != 'draft'">
                    <group string="Step 1 — Export from QuickBooks">
                        <div colspan="2" class="text-muted">
                            <p><b>QuickBooks Online:</b> Sales → Customers → click the export icon (top right) → Export to Excel → save as CSV.</p>
                            <p><b>QuickBooks Desktop:</b> Customer Center → Excel → Export Customer List → save as CSV.</p>
                            <p>The Lite edition imports up to 100 customers per file. Pro removes the cap and adds direct API sync.</p>
                        </div>
                    </group>
                    <group string="Step 2 — Upload">
                        <field name="csv_file" filename="csv_filename" required="1"/>
                        <field name="csv_filename" invisible="1"/>
                        <field name="overwrite"/>
                    </group>
                </group>

                <group invisible="state != 'done'">
                    <field name="log" nolabel="1" readonly="1" widget="text"/>
                </group>

                <footer>
                    <button name="action_import"
                            type="object"
                            string="Import"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_qb_customer_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Customers from QuickBooks</field>
        <field name="res_model">qb.customer.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
